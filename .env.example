# --- LLM provider: azure | openai | groq ---
LLM_PROVIDER=azure

# Azure OpenAI / Microsoft Foundry (needs TWO deployments: a chat model and an embedding model)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIM=1536

# Plain OpenAI alternative (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq (LLM_PROVIDER=groq) — chat via Groq; embeddings via local FastEmbed
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Set EMBEDDING_DIM=384 when using BAAI/bge-small-en-v1.5

# Neo4j (password must be at least 8 characters)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_please
